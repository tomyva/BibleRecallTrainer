<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="BibleRecallTrainer.Views.DashboardPage" Title="Bible Recall Trainer"><ScrollView><VerticalStackLayout Padding="24" Spacing="18"><Label Text="Bible Recall Trainer" Style="{StaticResource Headline}" HorizontalOptions="Start" HorizontalTextAlignment="Start"/><Label Text="Read · Recall · Quiz · Correct · Repeat"/><Frame BackgroundColor="#EDF3EB" Padding="18"><VerticalStackLayout Spacing="8"><Label Text="{Binding DayLabel}" FontAttributes="Bold" FontSize="18"/><Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto"><Label Text="Total chapters"/><Label Grid.Column="1" Text="Mastered"/><Label Grid.Column="2" Text="Learning"/><Label Grid.Row="1" Text="{Binding TotalChapters}" FontSize="22"/><Label Grid.Row="1" Grid.Column="1" Text="{Binding Mastered}" FontSize="22"/><Label Grid.Row="1" Grid.Column="2" Text="{Binding Learning}" FontSize="22"/></Grid><Label Text="Not Started: {Binding NotStarted}"/></VerticalStackLayout></Frame><Button Text="Learn" Command="{Binding LearnCommand}"/><Button Text="Recall (Coming soon)" IsEnabled="False"/><Button Text="Quiz (Coming soon)" IsEnabled="False"/><Button Text="Rapid Fire (Coming soon)" IsEnabled="False"/></VerticalStackLayout></ScrollView></ContentPage>
