<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="BibleRecallTrainer.Views.ChapterReaderPage" Title="{Binding Title}"><Grid RowDefinitions="Auto,*,Auto" Padding="20"><Label Text="{Binding Title}" Style="{StaticResource Headline}" HorizontalOptions="Start" HorizontalTextAlignment="Start"/><CollectionView Grid.Row="1" ItemsSource="{Binding Chapter.Verses}" Margin="0,16"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="36,*" Padding="0,6"><Label Text="{Binding Number}" FontAttributes="Bold"/><Label Grid.Column="1" Text="{Binding Text}" LineBreakMode="WordWrap"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView><Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12"><Button Text="Previous" IsEnabled="False"/><Button Grid.Column="1" Text="Next" IsEnabled="False"/></Grid></Grid></ContentPage>
